<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name="org.campusreader.auth.CampusApplication">
        <activity android:name="org.campusreader.auth.CampusConfigActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" android:windowSoftInputMode="adjustResize" />
        <!-- The bundled provider reads vendor device metadata during automatic startup. -->
        <provider android:name="com.sangfor.sdk.storageipc.provider.HSProvider" tools:node="remove" />
        <provider android:name="org.campusreader.auth.ConsentStorageProvider"
            android:authorities="${applicationId}.sangfor.ssl.safe.prd" android:exported="false" />
        <activity android:name="org.campusreader.auth.CampusAuthActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <service android:name="com.sangfor.atrust.sdp_tunnel.SdpVpnService"
            android:enabled="true" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE" />
        <activity android:name="com.sangfor.atrust.sdp_tunnel.VpnPermissionActivity"
            android:configChanges="orientation|keyboardHidden|screenSize" android:exported="false" android:launchMode="singleInstance" />
    </application>
</manifest>
