        <item name="android:colorAccent">@color/reader_accent</item>
        <item name="android:colorControlActivated">@color/reader_accent</item>
        <item name="android:statusBarColor">@color/reader_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/reader_ink</item>
        <item name="android:textColorSecondary">@color/reader_muted</item>
        <item name="android:navigationBarColor">@color/reader_ink</item>
        <item name="android:windowBackground">@color/reader_background</item>
        <item name="android:colorButtonNormal">@color/reader_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
