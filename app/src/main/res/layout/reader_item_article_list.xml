<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="18dp" android:gravity="center_vertical" android:minHeight="100dp" android:background="@color/reader_surface">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/reader_content_txt" android:text="" android:textSize="18sp" android:textColor="@color/reader_ink" android:maxLines="4" android:ellipsize="end" android:lineSpacingExtra="3dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/reader_title_txt" android:text="" android:textSize="13sp" android:textColor="@color/reader_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/reader_date" android:layout_marginStart="10dp" android:text="" android:textSize="13sp" android:textColor="@color/reader_ink" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:id="@+id/reader_image_star_lg" android:layout_marginStart="8dp" android:src="@drawable/reader_bookmark" android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
