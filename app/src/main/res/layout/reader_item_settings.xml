<?xml version="1.0" encoding="utf-8"?>
<!-- Project-authored layout, MIT. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:id="@+id/reader_left_icon" android:layout_marginEnd="20dp" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/reader_main_text" android:text="" android:textSize="16sp" android:textColor="#202124" android:layout_weight="1" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:id="@+id/reader_right_icon" android:src="@drawable/reader_chevron" android:importantForAccessibility="no" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:id="@+id/reader_line" android:background="#E8EAED" />
</LinearLayout>
