<?xml version="1.0" encoding="utf-8"?>
<!-- Image and text occupy separate surfaces so every title remains readable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/reader_surface" android:paddingBottom="12dp">
    <ImageView android:layout_width="match_parent" android:layout_height="184dp" android:id="@+id/reader_photo_preview" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:layout_width="0dp" android:layout_height="0dp" android:id="@+id/reader_card_gradient" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/reader_content_txt" android:textSize="18sp" android:textColor="@color/reader_ink" android:maxLines="5" android:ellipsize="end" android:lineSpacingExtra="3dp" />
        <TextView android:id="@+id/reader_summary_txt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="14sp" android:textColor="@color/reader_muted" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/reader_reason_txt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/reader_muted" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/reader_title_txt" android:textSize="13sp" android:textColor="@color/reader_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/reader_date" android:layout_marginStart="10dp" android:textSize="13sp" android:textColor="@color/reader_muted" />
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:id="@+id/reader_image_star_lg" android:layout_marginStart="10dp" android:src="@drawable/reader_bookmark" android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
