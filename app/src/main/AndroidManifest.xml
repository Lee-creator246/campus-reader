<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name="org.campusreader.auth.CampusApplication"
        android:label="北邮人信息"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.CampusReader"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Highest-priority removal is required because the vendor AAR is a direct app dependency. -->
        <provider android:name="com.sangfor.sdk.storageipc.provider.HSProvider" tools:node="remove" />
        <activity android:name="org.campusreader.reader.ReaderActivity"
            android:exported="false" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".LoginActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".InterestsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SurveyActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PortalLoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ReaderSettingsActivity" android:exported="false" />
        <activity android:name=".KeywordRulesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RulePreviewActivity" android:exported="false" />
        <activity android:name=".NotificationHistoryActivity" android:exported="false" />
        <activity android:name=".AiSummaryActivity" android:exported="false" />
        <activity android:name=".AiSettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PolicyLibraryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MediaViewerActivity" android:exported="false" />
        <activity android:name=".MediaDownloadsActivity" android:exported="false" />
        <activity android:name=".MediaExportActivity" android:exported="false" />
        <provider android:name=".MediaShareProvider" android:authorities="${applicationId}.media"
            android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".RefreshJobService" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".AiAutoJobService" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".RefreshBootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".NoticeReminderReceiver" android:exported="false" />
        <receiver android:name=".NoticeNotificationActionReceiver" android:exported="false" />
    </application>
</manifest>
